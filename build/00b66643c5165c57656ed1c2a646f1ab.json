10pt","text_align":"right","text_baseline":"middle","x":0,"y":1,"x_offset":-10}}]}},{"type":"object","name":"Row","id":"p3190","attributes":{"children":[{"type":"object","name":"Select","id":"p3187","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"type":"object","name":"CustomJS","id":"p3189","attributes":{"args":{"type":"map","entries":[["source_disc",{"id":"p3055"}],["source_cont",{"id":"p3058"}],["caso_select",{"id":"p3187"}],["info",{"type":"object","name":"Div","id":"p3188","attributes":{"width":600,"text":"\n<b>Ambig\u00fcedad en frecuencia discreta</b><br>\n<span style=\"font-size:18px;\">\n\u03a9\u2081 = \u03c0/4, &nbsp;&nbsp; \u03a9\u2082 = 9\u03c0/4\n</span><br><br>\n\nLas curvas discontinuas muestran las se\u00f1ales continuas\n<span style=\"font-size:17px;\">cos(\u03a9\u2081t)</span> y\n<span style=\"font-size:17px;\">cos(\u03a9\u2082t)</span>. Son distintas.<br><br>\n\nSin embargo, las muestras en los enteros coinciden:\n<span style=\"font-size:17px;\">cos(\u03a9\u2081n)=cos(\u03a9\u2082n)</span>.\n"}}]]},"code":"\n    const data_disc = source_disc.data;\n    const data_cont = source_cont.data;\n\n    const n = data_disc[\"n\"];\n    const t = data_cont[\"t\"];\n\n    const casos = {\n        \"\u03c0/4  y  9\u03c0/4\": {\n            Omega1: Math.PI/4,\n            Omega2: 9*Math.PI/4,\n            label1: \"\u03c0/4\",\n            label2: \"9\u03c0/4\",\n        },\n        \"\u03c0/3  y  7\u03c0/3\": {\n            Omega1: Math.PI/3,\n            Omega2: 7*Math.PI/3,\n            label1: \"\u03c0/3\",\n            label2: \"7\u03c0/3\",\n        },\n        \"3\u03c0/4  y  11\u03c0/4\": {\n            Omega1: 3*Math.PI/4,\n            Omega2: 11*Math.PI/4,\n            label1: \"3\u03c0/4\",\n            label2: \"11\u03c0/4\",\n        },\n        \"-\u03c0/4  y  7\u03c0/4\": {\n            Omega1: -Math.PI/4,\n            Omega2: 7*Math.PI/4,\n            label1: \"-\u03c0/4\",\n            label2: \"7\u03c0/4\",\n        },\n    };\n\n    const caso = casos[caso_select.value];\n\n    const Omega1 = caso.Omega1;\n    const Omega2 = caso.Omega2;\n\n    const x1_disc = [];\n    const x2_disc = [];\n    const x1_cont = [];\n    const x2_cont = [];\n    const diff = [];\n\n    for (let i = 0; i < n.length; i++) {\n        const ni = n[i];\n\n        const a = Math.cos(Omega1*ni);\n        const b = Math.cos(Omega2*ni);\n\n        x1_disc.push(a);\n        x2_disc.push(b);\n        diff.push(Math.abs(a - b));\n    }\n\n    for (let i = 0; i < t.length; i++) {\n        const ti = t[i];\n\n        x1_cont.push(Math.cos(Omega1*ti));\n        x2_cont.push(Math.cos(Omega2*ti));\n    }\n\n    data_disc[\"x1_disc\"] = x1_disc;\n    data_disc[\"x2_disc\"] = x2_disc;\n\n    data_cont[\"x1_cont\"] = x1_cont;\n    data_cont[\"x2_cont\"] = x2_cont;\n\n    const max_diff = Math.max(...diff);\n\n    info.text = `\n    <b>Ambig\u00fcedad en frecuencia discreta</b><br>\n    <span style=\"font-size:18px;\">\n    \u03a9\u2081 = ${caso.label1}, &nbsp;&nbsp; \u03a9\u2082 = ${caso.label2}\n    </span><br><br>\n\n    Las curvas discontinuas representan las se\u00f1ales continuas\n    <span style=\"font-size:17px;\">cos(\u03a9\u2081t)</span> y\n    <span style=\"font-size:17px;\">cos(\u03a9\u2082t)</span>.<br>\n    En continuo son se\u00f1ales distintas porque oscilan a velocidades diferentes.<br><br>\n\n    Pero al evaluar s\u00f3lo en enteros,\n    <span style=\"font-size:17px;\">t=n</span>, las muestras coinciden exactamente:<br><br>\n\n    <span style=\"font-size:18px;\">\n    cos(\u03a9\u2081n)=cos(\u03a9\u2082n)\n    </span><br><br>\n\n    Diferencia m\u00e1xima entre las muestras:\n    <b>${max_diff.toExponential(2)}</b>.\n    `;\n\n    source_disc.change.emit();\n    source_cont.change.emit();\n    "}}]]]},"width":230,"title":"Frecuencias comparadas","options":["\u03c0/4  y  9\u03c0/4","\u03c0/3  y  7\u03c0/3","3\u03c0/4  y  11\u03c0/4","-\u03c0/4  y  7\u03c0/4"],"value":"\u03c0/4  y  9\u03c0/4"}}]}},{"id":"p3188"}]}}]}};
