ect","name":"Row","id":"p1832","attributes":{"children":[{"type":"object","name":"Slider","id":"p1827","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"type":"object","name":"CustomJS","id":"p1831","attributes":{"args":{"type":"map","entries":[["source",{"id":"p1707"}],["alpha_slider",{"id":"p1827"}],["beta_slider",{"type":"object","name":"Slider","id":"p1828","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p1831"}]]]},"width":190,"title":"\u03b2","start":-3.0,"end":3.0,"value":0.0,"step":0.1}}],["order_select",{"type":"object","name":"Select","id":"p1829","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p1831"}]]]},"width":220,"title":"Orden de transformaci\u00f3n","options":["1) Desplazar y luego escalar","2) Escalar y luego desplazar"],"value":"1) Desplazar y luego escalar"}}],["info",{"type":"object","name":"Div","id":"p1830","attributes":{"width":600,"text":"\n<b>Ejercicio</b><br>\nAjusta los par\u00e1metros y el orden de transformaci\u00f3n para obtener:<br>\n<span style=\"font-size:18px;\">y(t) = x(1.5t + 1)</span><br><br>\n\nRecuerda el procedimiento recomendado:<br>\n1. Primero desplazar: <span style=\"font-size:17px;\">x(t) \u2192 x(t + \u03b2)</span><br>\n2. Despu\u00e9s escalar: <span style=\"font-size:17px;\">x(t + \u03b2) \u2192 x(\u03b1t + \u03b2)</span>\n"}}],["alpha_target",1.5],["beta_target",1.0]]},"code":"\n    const data = source.data;\n    const t = data[\"t\"];\n\n    const alpha = alpha_slider.value;\n    const beta = beta_slider.value;\n    const order = order_select.value;\n\n    const x = [];\n    const target = [];\n    const student = [];\n    const intermediate = [];\n\n    function xbase(u) {\n        return (\n            1.1*Math.exp(-0.7*(u + 1.0)*(u + 1.0))\n            - 0.7*Math.exp(-1.2*(u - 1.4)*(u - 1.4))\n            + 0.25*Math.exp(-0.4*u*u)*Math.sin(2*Math.PI*0.8*u)\n        );\n    }\n\n    for (let i = 0; i < t.length; i++) {\n        const ti = t[i];\n\n        x.push(xbase(ti));\n        target.push(xbase(alpha_target*ti + beta_target));\n\n        let inter;\n        let out;\n\n        if (order === \"1) Desplazar y luego escalar\") {\n            inter = xbase(ti + beta);\n            out = xbase(alpha*ti + beta);\n        }\n\n        else {\n            inter = xbase(alpha*ti);\n            out = xbase(alpha*(ti + beta));\n        }\n\n        intermediate.push(inter);\n        student.push(out);\n    }\n\n    data[\"x\"] = x;\n    data[\"target\"] = target;\n    data[\"intermediate\"] = intermediate;\n    data[\"student\"] = student;\n\n    let error = 0;\n    for (let i = 0; i < t.length; i++) {\n        const diff = student[i] - target[i];\n        error += diff*diff;\n    }\n    error = Math.sqrt(error/t.length);\n\n    let message = \"\";\n\n    if (error < 0.02) {\n        message = \"<b style='color:green;'>Correcto.</b> Has obtenido pr\u00e1cticamente la se\u00f1al objetivo.\";\n    } else {\n        message = \"<b style='color:firebrick;'>Todav\u00eda no coincide.</b> Ajusta \u03b1, \u03b2 y el orden.\";\n    }\n\n    info.text = `\n    <b>Ejercicio</b><br>\n    Objetivo:\n    <span style=\"font-size:18px;\">y(t) = x(1.5t + 1)</span><br><br>\n\n    Tus valores:<br>\n    \u03b1 = ${alpha.toFixed(2)}<br>\n    \u03b2 = ${beta.toFixed(2)}<br>\n    Orden: ${order}<br><br>\n\n    Error respecto al objetivo: ${error.toFixed(4)}<br>\n    ${message}<br><br>\n\n    <b>Pista:</b><br>\n    F\u00edjate en que incluso usando los valores correctos de \u03b1 y \u03b2,\n    si cambias el orden de las transformaciones,\n    el resultado ya no coincide con la se\u00f1al objetivo.<br><br>\n\n    En general:\n    <span style=\"font-size:17px;\">x(\u03b1t + \u03b2) \u2260 x(\u03b1(t + \u03b2))</span>\n    `;\n\n    source.change.emit();\n    "}}]]]},"width":190,"title":"\u03b1","start":-3.0,"end":3.0,"value":1.0,"step":0.1}},{"id":"p1828"},{"id":"p1829"}]}},{"id":"p1830"}]}}]}};
