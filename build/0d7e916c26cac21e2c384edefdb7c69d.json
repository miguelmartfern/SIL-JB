se_line'];\n    var y1_val = d['y_max'];\n\n    if (d['is_voiced'] && !slider.disabled && current_f0 > 0) {\n        s_f0.data = {x: [current_f0], y0: [y0_val], y1: [y1_val]};\n\n        var hx = [], hy0 = [], hy1 = [];\n\n        // Empezamos en k=2\n        var k = 2;\n        var freq = current_f0 * k;\n\n        // Bucle \"Infinito\" hasta salir de la pantalla\n        while (freq < freq_max && k < 300) { // limite 300 por seguridad del navegador\n            hx.push(freq);\n            hy0.push(y0_val);\n            hy1.push(y1_val);\n            k++;\n            freq = current_f0 * k;\n        }\n\n        s_harm.data = {x: hx, y0: hy0, y1: hy1};\n    } else {\n        s_f0.data = {x: [], y0: [], y1: []}; s_harm.data = {x: [], y0: [], y1: []};\n    }\n\n    s_f0.change.emit(); s_harm.change.emit();\n"}}]]]},"title":"Selecciona Fonema:","options":["e (Vocal)","s (Fricativa)","a (Vocal)"],"value":"e (Vocal)"}},{"id":"p1287"}]}},{"type":"object","name":"Figure","id":"p1170","attributes":{"width":700,"height":150,"x_range":{"type":"object","name":"Range1d","id":"p1180","attributes":{"end":0.576}},"y_range":{"type":"object","name":"DataRange1d","id":"p1172"},"x_scale":{"type":"object","name":"LinearScale","id":"p1181"},"y_scale":{"type":"object","name":"LinearScale","id":"p1182"},"title":{"type":"object","name":"Title","id":"p1173","attributes":{"text":"Se\u00f1al en tiempo"}},"renderers":[{"type":"object","name":"GlyphRenderer","id":"p1199","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p1167","attributes":{"selected":{"type":"object","name":"Selection","id":"p1168","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p1169"},"data":{"type":"map","entries":[["t",{"type":"ndarray","array":{"type":"bytes","data":""},"shape":[5530],"dtype":"float64","order":"little"}],["amp",{"type":"ndarray","array":{"type":"bytes","data":""},"shape":[5530],"dtype":"float32","order":"little"}]