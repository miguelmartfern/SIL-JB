Slider","id":"p8234","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p8237"}]]]},"title":"Separaci\u00f3n (Periodo/Ancho)","start":2.0,"end":6.0,"value":2.0,"step":0.1}}],["s_scale",{"type":"object","name":"Slider","id":"p8235","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p8237"}]]]},"title":"Escala Temporal (\u03b1)","start":0.5,"end":2.0,"value":1.0,"step":0.1}}]]},"code":"\n    const td = s_td.value;\n    const sep_factor = s_sep.value;\n    const scale = s_scale.value; // alpha\n\n    // Par\u00e1metros BASE (sin escalar)\n    const WIDTH_BASE = 1.0;\n    const DIST_BASE = sep_factor * WIDTH_BASE;\n    const T_PERIOD_BASE = 2 * DIST_BASE;\n    const W0_BASE = 2 * Math.PI / T_PERIOD_BASE;\n\n    // Par\u00e1metros ACTUALES (visualizaci\u00f3n tiempo)\n    const width_curr = WIDTH_BASE * scale;\n\n    // --- 1. TIEMPO ---\n    // Modelo: Se\u00f1al base desplazada td, LUEGO escalada por alpha (scale)\n    // El centro del pulso k se mueve a: scale * (k*DIST_BASE + td)\n\n    const t = source_sig.data['t'];\n    const y = source_sig.data['y'];\n    const y_g = source_ghost.data['y'];\n\n    for(let i=0; i<t.length; i++) { y[i]=0; y_g[i]=0; }\n\n    for (let k = -12; k <= 12; k++) {\n        let sign = (Math.abs(k) % 2 === 0) ? 1 : -1;\n\n        // Centro din\u00e1mico\n        let center = scale * (k * DIST_BASE + td);\n\n        // Centro fantasma (td=0, pero s\u00ed escalado para comparar forma)\n        let center_g = scale * (k * DIST_BASE);\n\n        for (let i = 0; i < t.length; i++) {\n            let val = 1 - Math.abs(t[i] - center) / width_curr;\n            if (val > 0) y[i] += sign * val;\n\n            let val_g = 1 - Math.abs(t[i] - center_g) / width_curr;\n            if (val_g > 0) y_g[i] += sign * val_g;\n        }\n    }\n    source_sig.change.emit();\n    source_ghost.change.emit();\n\n    // Marcador visual (sigue el desplazamiento escalado)\n    source_marker.data['x'][0] = td * scale; \n    source_marker.change.emit();\n\n    // --- 2. FRECUENCIA ---\n    // AQU\u00cd ESTA LA MAGIA: \n    // Usamos W0_BASE y DIST_BASE. La escala temporal NO afecta a ck.\n    // El \u00e1ngulo solo depende de 'td' relativo al periodo base.\n\n    const k_arr = source_freq.data['k'];\n    const mag = source_freq.data['mag'];\n    const ph = source_freq.data['phase'];\n    const ph_trend = source_freq.data['phase_trend'];\n    const re = source_freq.data['re'];\n    const im = source_freq.data['im'];\n    const two_pi = 2 * Math.PI;\n\n    const scale_amp = 1.0 / sep_factor;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n\n        // FASE TE\u00d3RICA (Recta gu\u00eda)\n        // angle = -k * w0_base * td\n        let angle = -k * W0_BASE * td;\n\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n        ph_trend[i] = wrapped;\n\n        if (k % 2 === 0) {\n            mag[i]=0; ph[i]=0; re[i]=0; im[i]=0;\n        } else {\n            // Sinc usa par\u00e1metros base (forma de onda relativa)\n            let arg = k * Math.PI / (2 * sep_factor);\n            let sinc_val = (Math.abs(arg) < 1e-9) ? 1.0 : Math.sin(arg)/arg;\n            let m = (sinc_val * sinc_val) * scale_amp;\n\n            mag[i] = m;\n            re[i] = m * Math.cos(angle);\n            im[i] = m * Math.sin(angle);\n\n            if (m < 1e-5) ph[i] = 0;\n            else ph[i] = wrapped;\n        }\n    }\n    source_freq.change.emit();\n"}}]]]},"title":"Desplazamiento (td)","start":0,"end":5.0,"value":0,"step":0.1}},{"id":"p8234"},{"id":"p8235"}]}},{"type":"object","name":"Figure","id":"p7772","attributes":{"width":700,"height":300,"x_range":{"type":"object","name":"DataRange1d","id":"p7773","attributes":{"start":-16.5,"end":16.5}},"y_range":{"type":"object","name":"DataRange1d","id":"p7774","attributes":{"start":-1.408,"end":1.7588}},"x_scale":{"type":"object","n