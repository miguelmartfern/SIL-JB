es":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p4311"}]]]},"title":"Separaci\u00f3n (Periodo/Ancho)","start":2.0,"end":6.0,"value":2.0,"step":0.1}}],["s_scale",{"type":"object","name":"Slider","id":"p4309","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p4311"}]]]},"title":"Escala Temporal (\u03b1)","start":0.5,"end":2.0,"value":1.0,"step":0.1}}]]},"code":"\n    const td = s_td.value;\n    const sep_factor = s_sep.value;\n    const scale = s_scale.value;\n\n    const WIDTH_BASE = 1.0;\n    const width = WIDTH_BASE * scale;       \n    const dist = sep_factor * width;        \n    const T_period = 2 * dist;\n    const w0 = 2 * Math.PI / T_period;\n\n    // --- 1. TIEMPO ---\n    const t = source_sig.data['t'];\n    const y = source_sig.data['y'];\n    const y_g = source_ghost.data['y'];\n\n    for(let i=0; i<t.length; i++) { y[i]=0; y_g[i]=0; }\n\n    for (let k = -12; k <= 12; k++) {\n        let sign = (Math.abs(k) % 2 === 0) ? 1 : -1;\n        let center = k * dist + td;\n        let center_g = k * dist;\n\n        for (let i = 0; i < t.length; i++) {\n            let val = 1 - Math.abs(t[i] - center) / width;\n            if (val > 0) y[i] += sign * val;\n            let val_g = 1 - Math.abs(t[i] - center_g) / width;\n            if (val_g > 0) y_g[i] += sign * val_g;\n        }\n    }\n    source_sig.change.emit();\n    source_ghost.change.emit();\n    source_marker.data['x'][0] = td;\n    source_marker.change.emit();\n\n    // --- 2. FRECUENCIA ---\n    const k_arr = source_freq.data['k'];\n    const mag = source_freq.data['mag'];\n    const ph = source_freq.data['phase'];\n    const ph_trend = source_freq.data['phase_trend'];\n    const re = source_freq.data['re'];\n    const im = source_freq.data['im'];\n    const two_pi = 2 * Math.PI;\n\n    const scale_amp = 1.0 / sep_factor;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n\n        // Tendencia (fase te\u00f3rica)\n        let angle = -k * w0 * td;\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n        ph_trend[i] = wrapped;\n\n        if (k % 2 === 0) {\n            mag[i]=0; ph[i]=0; re[i]=0; im[i]=0;\n        } else {\n            let arg = k * Math.PI / (2 * sep_factor);\n            let sinc_val = (Math.abs(arg) < 1e-9) ? 1.0 : Math.sin(arg)/arg;\n            let m = (sinc_val * sinc_val) * scale_amp;\n\n            mag[i] = m;\n            re[i] = m * Math.cos(angle);\n            im[i] = m * Math.sin(angle);\n\n            if (m < 1e-5) ph[i] = 0;\n            else ph[i] = wrapped;\n        }\n    }\n    source_freq.change.emit();\n"}}]]]},"title":"Desplazamiento (td)","start":0,"end":5.0,"value":0,"step":0.1}},{"id":"p4308"},{"id":"p4309"}]}},{"type":"object","name":"Figure","id":"p3845","attributes":{"width":700,"height":300,"x_range":{"type":"object","name":"DataRange1d","id":"p3846","attributes":{"start":-18.0,"end":18.0}},"y_range":{"type":"object","name":"DataRange1d","id":"p3847","attributes":{"start":-1.8499999999999999,"end":2.2449999999999997}},"x_scale":{"type":"object","name":"LinearScale","id":"p3854"},"y_scale":{"type":"object","name":"LinearScale","id":"p3855"},"title":{"type":"object","name":"Title","id":"p3852"},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p3886","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p3880","attributes":{"selected":{"type":"object","name":"Selection","id":"p3881","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p3882"},"data":{"type":"map"}}},"view":{"type":"object","name":"CDSView","id":"p3887","attributes":{"filter":{"type":"object","name":"AllIndices","id":"p3888"}}},"glyph":{"type":"object","name":"Segment","id":"p3883","attributes":{"x0":{"type":"value","value":-18.0},"y0":{"type":"value","value":0},"x1":{