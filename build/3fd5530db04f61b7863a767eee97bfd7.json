0f3dica, no existe un entero N tal que\n            \u03a9\u2080N = 2\u03c0m.<br>\n            Por tanto, la se\u00f1al discreta <b>no se repite exactamente</b>.\n            `\n        },\n        \"\u03a9\u2080 = \u03c0  \u2192 peri\u00f3dica, N\u2080 = 2\": {\n            Omega: Math.PI,\n            N0: 2,\n            texto: `\n            <b>Caso peri\u00f3dico de m\u00e1xima frecuencia discreta.</b><br>\n            x[n]=cos(\u03c0n)=(-1)\u207f.<br>\n            La se\u00f1al cambia de signo en cada muestra y tiene <b>N\u2080 = 2</b>.\n            `\n        },\n    };\n\n    const caso = casos[select.value];\n    const Omega = caso.Omega;\n\n    const x = n.map(v => Math.cos(Omega*v));\n    const y0 = n.map(v => 0);\n\n    const x_cont = t.map(v => Math.cos(Omega*v));\n\n    source_samples.data = {\n        n: n,\n        x: x,\n        y0: y0,\n    };\n\n    source_cont.data = {\n        t: t,\n        x: x_cont,\n    };\n\n    let px = [];\n    let py0 = [];\n    let py1 = [];\n\n    if (caso.N0 !== null) {\n        for (let k = 0; k <= 79; k += caso.N0) {\n            px.push(k);\n            py0.push(-1.15);\n            py1.push(1.15);\n        }\n    }\n\n    source_period.data = {\n        x: px,\n        y0: py0,\n        y1: py1,\n    };\n\n    info.text = caso.texto;\n\n    source_samples.change.emit();\n    source_cont.change.emit();\n    source_period.change.emit();\n    "}}]]]},"width":500,"title":"Selecciona \u03a9\u2080:","options":["\u03a9\u2080 = 2\u03c0/12  \u2192 peri\u00f3dica, N\u2080 = 12","\u03a9\u2080 = 8\u03c0/31  \u2192 peri\u00f3dica, N\u2080 = 31","\u03a9\u2080 = 2/5  \u2192 no peri\u00f3dica","\u03a9\u2080 = \u03c0  \u2192 peri\u00f3dica, N\u2080 = 2"],"value":"\u03a9\u2080 = 2\u03c0/12  \u2192 peri\u00f3dica, N\u2080 = 12"}},{"id":"p3320"},{"type":"object","name":"Figure","id":"p3210","attributes":{"height":420,"x_range":{"type":"object","name":"Range1d","id":"p3219","attributes":{"start":-4.0,"end":84.0}},"y_range":{"type":"obj