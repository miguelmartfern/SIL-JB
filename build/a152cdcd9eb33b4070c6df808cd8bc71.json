  const docs_json = {"8139dcfe-f11f-49ef-b6a8-430a18d71c6f":{"version":"3.8.2","title":"Bokeh Application","config":{"type":"object","name":"DocumentConfig","id":"p22154","attributes":{"notifications":{"type":"object","name":"Notifications","id":"p22155"}}},"roots":[{"type":"object","name":"Column","id":"p22153","attributes":{"sizing_mode":"scale_width","children":[{"type":"object","name":"Slider","id":"p22150","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"type":"object","name":"CustomJS","id":"p22151","attributes":{"args":{"type":"map","entries":[["source_t",{"type":"object","name":"ColumnDataSource","id":"p21970","attributes":{"selected":{"type":"object","name":"Selection","id":"p21971","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p21972"},"data":{"type":"map","entries":[["t",{"type":"ndarray","array":{"type":"bytes","data":""},"shape":[500],"dtype":"float64","order":"little"}],["y",{"type":"ndarray","array":{"type":"bytes","data":""},"shape":[500],"dtype":"float64","order":"little"}]]}}}],["source_f",{"type":"object","name":"ColumnDataSource","id":"p21973","attributes":{"selected":{"type":"object","name":"Selection","id":"p21974","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p21975"},"data":{"type":"map","entries":[["k",{"type":"ndarray","array":{"type":"bytes","data":"H4sIAAEAAAAC/w3DBQ6AMBAAsMMZLsP+/1HapBERhaWVtY2tnb3JwdHJ2cXVzd3D0+zl7ePr5w8MXmT4aAAAAA=="},"shape":[26],"dtype":"int32","order":"little"}],["mag",{"type":"ndarray","array":{"type":"bytes","data":"H4sIAAEAAAAC/2NggICzGT/u//d/YA/lMohwrlm2vLIFzq8uqX5Wp64P5w9WAAC4fc520AAAAA=="},"shape":[26],"dtype":"float64","order":"little"}],["zeros",{"type":"ndarray","array":{"type":"bytes","data":"H4sIAAEAAAAC/2NgoA8AAC8CH9doAAAA"},"shape":[26],"dtype":"int32","order":"little"}]]}}}],["s_steep",{"id":"p22150"}]]},"code":"\n    const s = s_steep.value;\n    const PI = Math.PI;\n\n    // 1. GENERAR DATOS TIEMPO\n    const t = source_t.data['t'];\n    const y = source_t.data['y'];\n    const N_t = t.length;\n\n    // Normalizaci\u00f3n: tanh(s)\n    let norm = Math.tanh(s);\n    if (Math.abs(norm) < 1e-9) norm = 1.0;\n\n    for (let i = 0; i < N_t; i++) {\n        y[i] = Math.tanh(s * Math.sin(PI * t[i])) / norm;\n    }\n    source_t.change.emit();\n\n    // 2. CALCULAR DFT (Fourier) EN TIEMPO REAL\n    // Usamos un solo periodo para integrar: t va de 0 a 2 (T0=2) o de -1 a 1.\n    // Generamos internamente un vector de un periodo con resoluci\u00f3n fina\n    const N_integ = 200; // Puntos para integrar\n    const k_arr = source_f.data['k'];\n    const mag = source_f.data['mag'];\n\n    // Pre-calculamos se\u00f1al en un periodo [-1, 1]\n    let y_p = new Float32Array(N_integ);\n    let t_p = new Float32Array(N_integ);\n    for(let i=0; i<N_integ; i++){\n        // t va de -1 a 1 (excluyendo el ultimo punto para periodicidad estricta)\n        let ti = -1 + (2 * i / N_integ);\n        t_p[i] = ti;\n        y_p[i] = Math.tanh(s * Math.sin(PI * ti)) / norm;\n    }\n\n    // Bucle para cada arm\u00f3nico k\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n        let sum_re = 0.0;\n        let sum_im = 0.0;\n\n        // Integraci\u00f3n num\u00e9rica (Suma de Riemann)\n        for (let j = 0; j < N_integ; j++) {\n            // e^(-j * omega0 * k * t) -> omega0 = pi\n            let angle = PI * k * t_p[j];\n            let cos_val = Math.cos(angle);\n            let sin_val = Math.sin(angle); // -sin para exp complejo negativo\n\n            sum_re += y_p[j] * cos_val;\n            sum_im += y_p[j] * (-sin_val);\n        }\n        // Dividir por N_integ (promedio, equivalente a 1/T integral)\n        // Ojo: Para la serie exponencial compleja ck\n        // ck = (1/T0) * integral. Aqu\u00ed estamos promediando muestras, es correcto.\n        let re = sum_re / N_integ;\n        let im = sum_im / N_integ;\n\n        let m = Math.sqrt(re*re + im*im);\n\n        // Limpieza de ruido num\u00e9rico\n        if (m < 1e-3) m = 0;\n        mag[i] = m;\n    }\n    source_f.change.emit();\n"}}]]]},"title":"Abrupticidad (Pendiente)","start":0.1,"end":10.0,"value":0.5,"step":0.1}},{"type":"object","name":"Figure","id":"p21976","attributes":{"height":300,"x_range":{"type":"object","name":"DataRange1d","id":"p21977","attributes":{"start":-3.3,"end":3.3}},"y_range":{"type":"object","name":"DataRange1d","id":"p21978","attributes":{"start":-1.6900000000000002,"end":1.8590000000000002}},"x_scale":{"type":"object","name":"LinearScale","id":"p21986"},"y_scale":{"type":"object","name":"LinearScale","id":"p21987"},"title":{"type":"object","name":"Title","id":"p21979","attributes":{"text":"Se\u00f1al en el Tiempo: x(t)"}},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p22018","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p22012","attributes":{"selected":{"type":"object","name":"Selection","id":"p22013","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p22014"},"data":{"type":"map"}}},"view":{"type":"object","name":"CDSView","id":"p22019","attributes":{"filter":{"type":"object","name":"AllIndices","id":"p22020"}}},"glyph":{"type":"object","name":"Segment","id":"p22015","attributes":{"x0":{"type":"value","value":-3.3},"y0":{"type":"value","value":0},"x1":{"type":"value","value":3.3},"y1":{"type":"value","value":0},"line_width":{"type":"value","value":1.5}}},"nonselection_glyph":{"type":"object","name":"Segment","id":"p22016","attributes":{"x0":{"type":"value","value":-3.3},"y0":{"type":"value","value":0},"x1":{"type":"value","value":3.3},"y1":{"type":"value","value":0},"line_alpha":{"type":"value","value":0.1},"line_width":{"type":"value","value":1.5}}},"muted_glyph":{"type":"object","name":"Segment","id":"p22017","attributes":{"x0":{"type":"v