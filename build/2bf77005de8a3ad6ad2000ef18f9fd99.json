p2356","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p2357"}]]]},"title":"Separaci\u00f3n (Factor de Ancho)","start":2.0,"end":6.0,"value":2.0,"step":0.1}}]]},"code":"\n    const td = slider_td.value;\n    const sep_factor = slider_sep.value;\n\n    // Constantes f\u00edsicas\n    const WIDTH = 1.0;\n    const DIST = sep_factor * WIDTH;\n    const T_PERIOD = 2 * DIST;\n    const w0 = 2 * Math.PI / T_PERIOD;\n\n    // --- 1. RECALCULAR TIEMPO (Se\u00f1al y Ghost) ---\n    const t = source_sig.data['t'];\n    const y = source_sig.data['y'];\n    const y_ghost = source_ghost.data['y'];\n\n    // Reset arrays\n    for(let i=0; i<t.length; i++) { y[i]=0; y_ghost[i]=0; }\n\n    // Generar pulsos (rango suficiente para cubrir pantalla)\n    for (let k = -12; k <= 12; k++) {\n        let sign = (Math.abs(k) % 2 === 0) ? 1 : -1;\n\n        // Se\u00f1al movida (td)\n        let center = k * DIST + td;\n        for (let i = 0; i < t.length; i++) {\n            let val = 1 - Math.abs(t[i] - center) / WIDTH;\n            if (val > 0) y[i] += sign * val;\n        }\n\n        // Ghost (td=0) - Para ver c\u00f3mo cambia el periodo \"base\"\n        let center_g = k * DIST;\n        for (let i = 0; i < t.length; i++) {\n            let val = 1 - Math.abs(t[i] - center_g) / WIDTH;\n            if (val > 0) y_ghost[i] += sign * val;\n        }\n    }\n    source_sig.change.emit();\n    source_ghost.change.emit();\n\n    // Marker update\n    source_marker.data['x'][0] = td;\n    source_marker.change.emit();\n\n    // --- 2. RECALCULAR FRECUENCIA (Magnitud y Fase) ---\n    const k_arr = source_mag.data['k'];\n    const mag = source_mag.data['mag'];\n    const ph = source_ph.data['phase'];\n    const two_pi = 2 * Math.PI;\n\n    // Factor de escala de amplitud (1/T) para visualizaci\u00f3n\n    // Normalizamos para que cuando est\u00e9n pegados (sep=2) la altura sea 0.5 (aprox)\n    const scale_factor = (2 * WIDTH) / T_PERIOD;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n\n        // MAGNITUD\n        if (k % 2 === 0) {\n            mag[i] = 0;\n            ph[i] = 0;\n        } else {\n            // Sinc(k * w0 * W / 2)\n            // w0 * W / 2 = (2pi / 2*DIST) * W / 2 = pi * W / (2 * sep_factor * W) = pi / (2*sep_factor)\n            let arg = k * Math.PI / (2 * sep_factor);\n\n            // Sinc implementado manualmente: sin(x)/x\n            let sinc_val = 1.0;\n            if (Math.abs(arg) > 1e-8) {\n                sinc_val = Math.sin(arg) / arg;\n            }\n            // Sinc cuadrado * escala\n            mag[i] = (sinc_val * sinc_val) * scale_factor;\n\n            // FASE\n            // Si la magnitud es despreciable, fase 0\n            if (mag[i] < 1e-4) {\n                ph[i] = 0;\n            } else {\n                // Fase lineal: -k * w0 * td\n                // OJO: Hay un desfase extra de pi si el l\u00f3bulo de la sinc es negativo,\n                // pero como usamos sinc^2, la magnitud es siempre positiva.\n                // Sin embargo, para reconstruir correctamente, el signo importa.\n                // En esta demo visual simplificada, asumimos fase lineal sobre coeficientes positivos.\n\n                let angle = -k * w0 * td;\n                let wrapped = ((angle + Math.PI) % two_pi);\n                if (wrapped < 0) wrapped += two_pi;\n                wrapped -= Math.PI;\n                ph[i] = wrapped;\n            }\n        }\n    }\n    source_mag.change.emit();\n    source_ph.change.emit();\n"}}]]]},"title":"$$t_d$$ (Desplazamiento)","start":0,"end":5.0,"value":0,"step":0.1}},{"id":"p2356"}]}},{"type":"object","name":"Row","id":"p2360","attributes":{"children":[{"type":"object","name":"Figure","id":"p2064","attributes":{"width":550,"height":400,"x_range":{"type":"object","name":"DataRange1d","id":"p2065","attributes":{"start":-12.0,"end":12.0}},"y_range":{"type":"object","name":"DataRange1d","id":"p2066","attributes":{"st