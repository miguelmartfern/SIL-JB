 td;\n    source_marker.change.emit();\n\n    // --- 3. FASE ---\n    const k_arr = source_ph.data['k'];\n    const ph = source_ph.data['phase'];\n    const mag = source_mag.data['mag']; // Necesitamos la magnitud para limpiar fase de ceros\n    const two_pi = 2 * Math.PI;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n\n        // Si la magnitud es (casi) cero, la fase es irrelevante (o cero por convenci\u00f3n visual)\n        if (mag[i] < 0.001) {\n            ph[i] = 0; \n            continue;\n        }\n\n        // Fase lineal por desplazamiento: -k * w0 * td\n        // PERO: Si k es impar y el pulso original era centrado,\n        // la fase base es 0 (para los positivos).\n        // Como estamos modelando un tren que alterna, la matem\u00e1tica exacta del desplazamiento\n        // se mantiene: Phase = Phase_Original - k*w0*td\n\n        let angle = -k * w0 * td;\n\n        // Wrapping\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n\n        ph[i] = wrapped;\n    }\n    source_ph.change.emit();\n"}}]]]},"title":"$$t_d$$","start":0,"end":6.0,"value":0,"step":0.06}},{"type":"object","name":"Row","id":"p2033","attributes":{"children":[{"type":"object","name":"Figure","id":"p1714","attributes":{"width":550,"height":400,"x_range":{"type":"object","name":"DataRange1d","id":"p1715","attributes":{"start":-8.639999999999999,"end":8.639999999999999}},"y_range":{"type":"object","name":"DataRange1d","id":"p1716","attributes":{"start":-1.8499999999999999,"end":2.2449999999999997}},"x_scale":{"type":"object","name":"LinearScale","id":"p1724"},"y_scale":{"type":"object","name":"LinearScale","id":"p1725"},"title":{"type":"object","name":"Title","id":"p1717","attributes":{"text":"Se\u00f1al Alterna: \u00bfPar o Impar?"}},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p1756","attributes":{"data_source":{"type":"object","name":"