}},{"type":"object","name":"Label","id":"p1901","attributes":{"text":"amplitud","text_font_size":"11pt","anchor":"top_left","x":0,"y":3.25,"x_offset":12,"y_offset":-3}}]}},{"type":"object","name":"Row","id":"p1907","attributes":{"children":[{"type":"object","name":"Select","id":"p1902","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"type":"object","name":"CustomJS","id":"p1906","attributes":{"args":{"type":"map","entries":[["source",{"id":"p1813"}],["select",{"id":"p1902"}],["amp_slider",{"type":"object","name":"Slider","id":"p1903","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p1906"}]]]},"width":220,"title":"Amplitud A","start":0.2,"end":2.0,"value":1.0,"step":0.1}}],["period_slider",{"type":"object","name":"Slider","id":"p1904","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:value",[{"id":"p1906"}]]]},"width":220,"title":"Periodo T","start":0.5,"end":3.0,"value":1.0,"step":0.1}}],["texts",{"type":"map","entries":[["Coseno","\n    <b>Se\u00f1al peri\u00f3dica: coseno</b><br>\n    La se\u00f1al cumple:<br>\n    <span style=\"font-size:18px;\">x(t) = x(t+T)</span><br><br>\n    Puedes cambiar su amplitud A y su periodo T.\n    "],["Seno","\n    <b>Se\u00f1al peri\u00f3dica: seno</b><br>\n    La se\u00f1al cumple:<br>\n    <span style=\"font-size:18px;\">x(t) = x(t+T)</span><br><br>\n    Al aumentar T, la se\u00f1al oscila m\u00e1s lentamente.\n    "],["Suma de arm\u00f3nicos","\n    <b>Se\u00f1al peri\u00f3dica no sinusoidal</b><br>\n    Aunque no es un seno puro, sigue siendo peri\u00f3dica:<br>\n    <span style=\"font-size:18px;\">x(t) = x(t+T)</span><br><br>\n    Est\u00e1 formada por la suma de varios arm\u00f3nicos.\n    "],["Cuadrada","\n    <b>Se\u00f1al cuadrada peri\u00f3dica</b><br>\n    La se\u00f1al toma valores constantes por tramos, pero se repite cada periodo:<br>\n    <span style=\"font-size:18px;\">x(t) = x(t+T)</span>\n    "],["No peri\u00f3dica","\n    <b>Se\u00f1al no peri\u00f3dica</b><br>\n    En este caso, al desplazar la se\u00f1al un tiempo T, no coincide consigo misma:<br>\n    <span style=\"font-size:18px;\">x(t) \u2260 x(t+T)</span><br><br>\n    La envolvente exponencial rompe la periodicidad.\n    "]]}],["info",{"type":"object","name":"Div","id":"p1905","attributes":{"width":650,"text":"\n    <b>Se\u00f1al peri\u00f3dica: coseno</b><br>\n    La se\u00f1al cumple:<br>\n    <span style=\"font-size:18px;\">x(t) = x(t+T)</span><br><br>\n    Puedes cambiar su amplitud A y su periodo T.\n    "}}]]},"code":"\n    const data = source.data;\n    const t = data[\"t\"];\n\n    const name = select.value;\n    const A = amp_slider.value;\n    const T = period_slider.value;\n\n    const x = [];\n    const x_shift = [];\n\n    for (let i = 0; i < t.length; i++) {\n        const ti = t[i];\n\n        let value;\n        let value_shift;\n\n        if (name === \"Coseno\") {\n            value = A * Math.cos(2*Math.PI*ti/T);\n            value_shift = A * Math.cos(2*Math.PI*(ti + T)/T);\n        }\n\n        else if (name === \"Seno\") {\n            value = A * Math.sin(2*Math.PI*ti/T);\n            value_shift = A * Math.sin(2*Math.PI*(ti + T)/T);\n        }\n\n        else if (name === \"Suma de arm\u00f3nicos\") {\n            value = A * (\n                Math.cos(2*Math.PI*ti/T)\n                + 0.4*Math.cos(4*Math.PI*ti/T)\n            );\n\n            value_shift = A * (\n                Math.cos(2*Math.PI*(ti + T)/T)\n                + 0.4*Math.cos(4*Math.PI*(ti + T)/T)\n            );\n        }\n\n        else if (name === \"Cuadrada\") {\n            value = A * Math.sign(Math.sin(2*Math.PI*ti/T));\n            value_shift = A * Math.sign(Math.sin(2*Math.PI*(ti + T)/T));\n        }\n\n        else if (name === \"No peri\u00f3dica\") {\n            value = A * Math.exp(-0.4*ti*ti) * Math.cos(2*Math.PI*ti/T);\n\n            value_shift = A * Math.exp(-0.4*(ti + T)*(ti + T))\n                        * Math.cos(2*Math.PI*(ti + T)/T);\n        }\n\n        x.push(value);\n        x_shift.push(value_shift);\n    }\n\n    data[\"x\"] = x;\n    data[\"x_shift\"] = x_shift;\n\n    info.text = texts[name];\n\n    source.change.emit();\n    "}}]]]},"width":220,"title":"Tipo de se\u00f1al","options":["Coseno","Seno","Suma de arm\u00f3nicos","Cuadrada","No peri\u00f3dica"],"value":"Coseno"}},{"id":"p1903"},{"id":"p1904"}]}},{"id":"p1905"}]}}]}};
