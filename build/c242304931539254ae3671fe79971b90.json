urce_marker.change.emit();\n\n    // --- 3. FASE ---\n    const k_arr = source_ph.data['k'];\n    const ph = source_ph.data['phase'];\n    const mag = source_mag.data['mag']; // Necesitamos la magnitud para limpiar fase de ceros\n    const two_pi = 2 * Math.PI;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n\n        // Si la magnitud es (casi) cero, la fase es irrelevante (o cero por convenci\u00f3n visual)\n        if (mag[i] < 0.001) {\n            ph[i] = 0; \n            continue;\n        }\n\n        // Fase lineal por desplazamiento: -k * w0 * td\n        // PERO: Si k es impar y el pulso original era centrado,\n        // la fase base es 0 (para los positivos).\n        // Como estamos modelando un tren que alterna, la matem\u00e1tica exacta del desplazamiento\n        // se mantiene: Phase = Phase_Original - k*w0*td\n\n        let angle = -k * w0 * td;\n\n        // Wrapping\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n\n        ph[i] = wrapped;\n    }\n    source_ph.change.emit();\n"}}]]]},"title":"$$t_d$$","start":0,"end":8.0,"value":0,"step":0.08}},{"type":"object","name":"Row","id":"p1680","attributes":{"children":[{"type":"object","name":"Figure","id":"p1361","attributes":{"width":550,"height":400,"x_range":{"type":"object","name":"DataRange1d","id":"p1362","attributes":{"start":-11.52,"end":11.52}},"y_range":{"type":"object","name":"DataRange1d","id":"p1363","attributes":{"start":-1.8499999999999999,"end":2.2449999999999997}},"x_scale":{"type":"object","name":"LinearScale","id":"p1371"},"y_scale":{"type":"object","name":"LinearScale","id":"p1372"},"title":{"type":"object","name":"Title","id":"p1364","attributes":{"text":"Se\u00f1al Alterna: \u00bfPar o Impar?"}},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p1403","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p1397","attr