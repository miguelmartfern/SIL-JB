rce_dim.data['x_start'][0] = x0;\n    source_dim.data['x_end'][0] = x1;\n    lbl_t0.x = (x0 + x1) / 2;\n\n    // 3. FRECUENCIA\n    const k_arr = source_freq.data['k'];\n    const mag = source_freq.data['mag'];\n    const ph = source_freq.data['phase'];\n    const ph_trend = source_freq.data['phase_trend'];\n    const re = source_freq.data['re'];\n    const im = source_freq.data['im'];\n    const two_pi = 2 * Math.PI;\n    const scale_amp = 1.0 / sep_factor;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n        let angle = -k * W0_BASE * td;\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n        ph_trend[i] = wrapped;\n\n        if (k % 2 === 0) {\n            mag[i]=0; ph[i]=0; re[i]=0; im[i]=0;\n        } else {\n            let arg = k * Math.PI / (2 * sep_factor);\n            let sinc_val = (Math.abs(arg) < 1e-9) ? 1.0 : Math.sin(arg)/arg;\n            let m = (sinc_val * sinc_val) * scale_amp;\n            mag[i] = m;\n            re[i] = m * Math.cos(angle);\n            im[i] = m * Math.sin(angle);\n            if (m < 1e-5) ph[i] = 0;\n            else ph[i] = wrapped;\n        }\n    }\n    source_freq.change.emit();\n"}}]]]},"title":"Desplazamiento (td)","start":0,"end":5.0,"value":0.0,"step":0.1}},{"id":"p21951"},{"id":"p21952"},{"type":"object","name":"Button","id":"p21954","attributes":{"js_event_callbacks":{"type":"map","entries":[["button_click",[{"type":"object","name":"CustomJS","id":"p21955","attributes":{"args":{"type":"map","entries":[["s_td",{"id":"p21950"}],["s_sep",{"id":"p21951"}],["s_scale",{"id":"p21952"}],["v_td",0.0],["v_sep",2.0],["v_scale",1.0]]},"code":"\n    s_td.value = v_td;\n    s_sep.value = v_sep;\n    s_scale.value = v_scale;\n"}}]]]},"width":150,"label":"Reset Par\u00e1metros"}},{"type":"object","name":"RadioButtonGroup","id":"p21953","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:active",[{"t