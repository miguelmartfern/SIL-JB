nc_val = (Math.abs(arg) < 1e-9) ? 1.0 : Math.sin(arg)/arg;\n\n            let m = (sinc_val * sinc_val) * scale_amp;\n            mag[i] = m;\n\n            let angle = -k * w0 * td;\n            re[i] = m * Math.cos(angle);\n            im[i] = m * Math.sin(angle);\n\n            let wrapped = ((angle + Math.PI) % two_pi);\n            if (wrapped < 0) wrapped += two_pi;\n            wrapped -= Math.PI;\n\n            if (m < 1e-5) ph[i] = 0;\n            else ph[i] = wrapped;\n        }\n    }\n    source_freq.change.emit();\n"}}]]]},"title":"$$t_d$$ (Desplazamiento)","start":0,"end":5.0,"value":0,"step":0.1}},{"id":"p3325"},{"id":"p3326"}]}},{"type":"object","name":"RadioButtonGroup","id":"p3327","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:active",[{"type":"object","name":"CustomJS","id":"p3329","attributes":{"args":{"type":"map","entries":[["p_mag",{"type":"object","name":"Figure","id":"p2964","attributes":{"name":"plot_polar","width":400,"height":200,"x_range":{"type":"object","name":"DataRange1d","id":"p2965","attributes":{"start":-25.2,"end":25.2}},"y_range":{"type":"object","name":"DataRange1d","id":"p2966","attributes":{"start":-0.15,"end":0.795}},"x_scale":{"type":"object","name":"LinearScale","id":"p2973"},"y_scale":{"type":"object","name":"LinearScale","id":"p2974"},"title":{"type":"object","name":"Title","id":"p2971"},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p3005","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p2999","attributes":{"selected":{"type":"object","name":"Selection","id":"p3000","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p3001"},"data":{"type":"map"}}},"view":{"type":"object","name":"CDSView","id":"p3006","attributes":{"filter":{"type":"object","name":"AllIndices","id":"p3007"}}},"glyph":{"type":"object","name":"Segment","id":"p3002","attributes":{"x0":{"type":"value","val