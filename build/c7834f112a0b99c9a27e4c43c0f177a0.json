ctor;\n\n    for (let i = 0; i < k_arr.length; i++) {\n        let k = k_arr[i];\n        let angle = -k * W0_BASE * td;\n        let wrapped = ((angle + Math.PI) % two_pi);\n        if (wrapped < 0) wrapped += two_pi;\n        wrapped -= Math.PI;\n        ph_trend[i] = wrapped;\n\n        if (k % 2 === 0) {\n            mag[i]=0; ph[i]=0; re[i]=0; im[i]=0;\n        } else {\n            let arg = k * Math.PI / (2 * sep_factor);\n            let sinc_val = (Math.abs(arg) < 1e-9) ? 1.0 : Math.sin(arg)/arg;\n            let m = (sinc_val * sinc_val) * scale_amp;\n            mag[i] = m;\n            re[i] = m * Math.cos(angle);\n            im[i] = m * Math.sin(angle);\n            if (m < 1e-5) ph[i] = 0;\n            else ph[i] = wrapped;\n        }\n    }\n    source_freq.change.emit();\n"}}]]]},"title":"Desplazamiento (td)","start":0,"end":5.0,"value":0,"step":0.1}},{"id":"p12257"},{"id":"p12258"},{"type":"object","name":"RadioButtonGroup","id":"p12259","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:active",[{"type":"object","name":"CustomJS","id":"p12261","attributes":{"args":{"type":"map","entries":[["p_mag",{"type":"object","name":"Figure","id":"p11847","attributes":{"name":"plot_polar","width":300,"height":200,"x_range":{"type":"object","name":"DataRange1d","id":"p11848","attributes":{"start":-23.1,"end":23.1}},"y_range":{"type":"object","name":"DataRange1d","id":"p11849","attributes":{"start":-0.09000000000000001,"end":0.729}},"x_scale":{"type":"object","name":"LinearScale","id":"p11856"},"y_scale":{"type":"object","name":"LinearScale","id":"p11857"},"title":{"type":"object","name":"Title","id":"p11854"},"outline_line_color":null,"renderers":[{"type":"object","name":"GlyphRenderer","id":"p11888","attributes":{"data_source":{"type":"object","name":"ColumnDataSource","id":"p11882","attributes":{"selected":{"type":"object","name":"Selection","id":"p11883","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object",